# Supabase Configuration
# Copy this file to .env and replace with your actual values
# IMPORTANT: Never commit the actual .env file to version control!

# Your Supabase project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (safe for client-side use)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Your Supabase service role key (NEVER expose this in client-side code!)
# This should only be used in server-side/backend code
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
